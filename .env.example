# Sugarloop API. Copy this file to `.env.local` and adjust for your machine.
#
# Vite only exposes variables prefixed with VITE_ to the browser, and they are
# INLINED AT BUILD TIME — so this is a public value baked into the bundle, never
# a place for a secret. Changing it requires a rebuild, not just a restart.
#
# Leave it EMPTY to run entirely on the bundled catalogue with no network calls
# at all. That is the safe default for a preview build, and how the site behaved
# before the backend existed.
#
#   local backend   http://localhost:4000/api/v1
#   staging         https://api-staging.sugarloop.pk/api/v1   (not deployed yet)
#   production      https://api.sugarloop.pk/api/v1           (not deployed yet)
#
# ⚠️ Whatever host you point at must list this site's origin in its CORS_ORIGINS,
# or the browser blocks the request before it reaches a route.
VITE_API_BASE_URL=http://localhost:4000/api/v1
